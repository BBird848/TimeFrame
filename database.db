CREATE TABLE timetable (
    student NOT NULL DEFAULT 'Student 1',
    time_slot NOT NULL,
    Monday  NULL DEFAULT '',
    Tuesday  NOT NULL DEFAULT '',
    Wednesday  NOT NULL DEFAULT '',
    Thursday  NOT NULL DEFAULT '',
    Friday  NOT NULL DEFAULT '',
    PRIMARY KEY (student, time_slot)
);

